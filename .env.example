# JARVIS Configuration — Copy to .env and edit

# Ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3

# Language
JARVIS_LANGUAGE=auto
JARVIS_TTS_VOICE=default

# HAVEN
HAVEN_ROOT=

# Email (IMAP)
EMAIL_IMAP_HOST=
EMAIL_IMAP_PORT=993
EMAIL_USERNAME=
EMAIL_PASSWORD=

# Email (SMTP)
EMAIL_SMTP_HOST=
EMAIL_SMTP_PORT=587

# Batch processing
BATCH_SIZE=5

# Whisper STT model: tiny, base, small, medium, large-v3
STT_MODEL=base

# Logging level: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO
